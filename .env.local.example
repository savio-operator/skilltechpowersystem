# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to git — it is already in .gitignore.

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# International format, no + or spaces: country code + number
# Example: India 98XXX XXXXX → 9198XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Pre-filled message for the default WhatsApp button (URL-encoded)
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE=Hi%2C%20I%27d%20like%20a%20free%20solar%20assessment%20for%20my%20home.

# ── Site URL ──────────────────────────────────────────────────────────────────
# No trailing slash
NEXT_PUBLIC_SITE_URL=https://skilltechpowersystem.in

# ── Email delivery (Resend) ───────────────────────────────────────────────────
# Get a free key at https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address shown as the sender (must be a verified domain in Resend)
CONTACT_FROM_EMAIL=noreply@skilltechpowersystem.in

# Where contact form submissions are delivered
CONTACT_RECIPIENT_EMAIL=skilltechpowersystem@gmail.com

# ── Analytics ─────────────────────────────────────────────────────────────────
# Google Analytics 4 — get from Google Analytics > Admin > Data Streams
# TODO: confirm-with-client
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Vercel Web Analytics — set to "true" to enable (also enable in Vercel dashboard)
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# ── Google Maps (optional) ────────────────────────────────────────────────────
# Only needed if you add an embedded map widget later
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...
